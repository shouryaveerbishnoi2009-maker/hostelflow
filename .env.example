# ============================================================================
# HostelFlow Environment Variables Template
# Copy this file to .env and configure your local or hosted Supabase database
# ============================================================================

# 1. DATABASE CONNECTION
# Render Free Tier supports IPv4. Supabase Direct Connection (port 5432) uses IPv6.
# THEREFORE: ALWAYS USE SUPABASE's CONNECTION POOLER URI (Port 6543) FOR RENDER DEPLOYMENTS:
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# 2. FLASK SECURITY
SECRET_KEY=generate-a-cryptographically-secure-random-secret-key-for-production

# 3. TIMEZONE (India Standard Time)
APP_TIMEZONE=Asia/Kolkata

# 4. ENVIRONMENT RUNTIME
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5001

# 5. DB POOL CONFIGURATION
DB_POOL_MIN=1
DB_POOL_MAX=10
